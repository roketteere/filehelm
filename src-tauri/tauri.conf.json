{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FileHelm",
  "version": "0.1.0",
  "identifier": "com.joelperez.filehelm",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5191",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FileHelm",
        "width": 1400,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Joel Perez",
    "copyright": "© 2026 Joel Perez. MIT-licensed.",
    "category": "DeveloperTool",
    "shortDescription": "Local project launcher + file commander",
    "longDescription": "FileHelm — auto-detects your dev projects' languages and run commands, launches them with one click. Includes a dual-pane file commander."
  },
  "plugins": {
    "updater": {
      "active": false,
      "pubkey": "",
      "endpoints": []
    }
  }
}
